ORACLE_PORT=8080
ORACLE_LOG_LEVEL=info
ORACLE_DATABASE_URL=file:oracle.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=foreign_keys(ON)

# Auth signing secret for Limen. Must be exactly 32 bytes. Generate with: openssl rand -hex 16
ORACLE_AUTH_SECRET=be3f72255b02cbc4b39540e18f250a7d

# Set the Secure attribute on the session cookie. Browsers reject Secure cookies
# over plain HTTP, so keep this false for local dev and set true behind TLS.
ORACLE_AUTH_COOKIE_SECURE=false

# LLM provider: mock (default, no keys needed) or openai.
# openai accepts any OpenAI-compatible endpoint via base URL (OpenAI, OpenRouter, LiteLLM, Ollama, ...).
ORACLE_LLM_PROVIDER=mock
#ORACLE_LLM_API_KEY=
#ORACLE_LLM_MODEL=
#ORACLE_LLM_BASE_URL=

# Tool permission ruleset. Verdicts: allow, deny, ask. Rules are evaluated in
# order and the last matching rule wins, except deny, which is absolute.
# Tool names support glob patterns. Unmatched tools fall back to the default.
ORACLE_PERMISSION_DEFAULT=ask
ORACLE_PERMISSION_RULES=get_time:allow

# Session goal loops. Poll interval scans sessions for due loop iterations;
# run timeout bounds each headless iteration.
ORACLE_LOOP_POLL_INTERVAL=5s
ORACLE_LOOP_RUN_TIMEOUT=10m

# Plain PORT is also honored for PaaS compatibility, but ORACLE_PORT wins when both are set.
